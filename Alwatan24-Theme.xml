<?xml version="1.0" encoding="UTF-8" ?>
<!-- AlWatan 24 - Guaranteed Safe Base Theme -->
<!DOCTYPE html>
<html b:css='true' b:defaultwidgetversion='2' b:layoutsVersion='3' b:responsive='true' expr:dir='data:blog.languageDirection' lang='ar'>
<head>
    <meta content='width=device-width, initial-scale=1.0' name='viewport'/>
    <title><data:blog.pageTitle/></title>
    <b:include data='blog' name='all-head-content'/>
    <b:skin><![CDATA[
      body {
        font-family: sans-serif;
        background-color: #f0f0f0;
        color: #333;
        margin: 0;
      }
      .header-container, .footer-container {
        background-color: #fff;
        padding: 20px;
        text-align: center;
        border-bottom: 1px solid #ddd;
      }
      .main-container {
        max-width: 1100px;
        margin: 20px auto;
        padding: 20px;
        background-color: #fff;
      }
       h1.title {
        font-size: 2em;
        color: #111;
      }
    ]]></b:skin>
</head>
<body>

    <header class='header-container'>
        <b:section id='header' class='header' maxwidgets='1' showaddelement='yes'>
            <b:widget id='Header1' type='Header' locked='true'>
              <b:includable id='main'>
                <b:if cond='data:blog.url == data:blog.homepageUrl'>
                  <h1 class='title'><data:blog.title/></h1>
                <b:else/>
                  <p class='title'><a expr:href='data:blog.homepageUrl'><data:blog.title/></a></p>
                </b:if>
              </b:includable>
            </b:widget>
        </b:section>
    </header>

    <div class='main-container'>
        <b:section id='main' class='main' maxwidgets='1' showaddelement='yes'>
            <b:widget id='Blog1' type='Blog' locked='true'>
                <b:includable id='main'>
                    <b:loop values='data:posts' var='post'>
                        <div class='post'>
                            <h2><a expr:href='data:post.url'><data:post.title/></a></h2>
                            <p><data:post.body/></p>
                        </div>
                    </b:loop>
                </b:includable>
            </b:widget>
        </b:section>
    </div>

    <footer class='footer-container'>
         <p>Copyright &#169; <data:blog.title/></p>
    </footer>

</body>
</html>
