<?xml version="1.0" encoding="UTF-8" ?>
<!-- AlWatan 24 - The Final, Simplest, Working Theme -->
<!DOCTYPE html>
<html b:css='true' b:defaultwidgetversion='2' b:layoutsVersion='3' b:responsive='true' expr:dir='data:blog.languageDirection' lang='ar'>
<head>
    <meta content='width=device-width, initial-scale=1.0' name='viewport'/>
    <title><data:blog.pageTitle/></title>
    <b:include data='blog' name='all-head-content'/>
    <b:skin><![CDATA[
      body {
        direction: rtl;
        text-align: right;
        font-family: Arial, sans-serif;
        background: #f0f0f0;
        color: #000;
        margin: 0;
        padding: 20px;
      }
      #page-wrapper {
        background: #fff;
        max-width: 900px;
        margin: 0 auto;
        padding: 20px;
        border: 1px solid #ccc;
      }
      .header-section {
        padding-bottom: 20px;
        margin-bottom: 20px;
        border-bottom: 2px solid #000;
        text-align: center;
      }
      .post {
        margin-bottom: 20px;
        padding-bottom: 20px;
        border-bottom: 1px solid #eee;
      }
      .post-title a {
        font-size: 24px;
        color: #0D47A1;
        text-decoration: none;
      }
      .no-posts-found {
        font-size: 18px;
        font-weight: bold;
        color: #E53935;
        text-align: center;
        padding: 50px;
      }
      .footer-section {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 2px solid #000;
        text-align: center;
        font-size: 14px;
      }
    ]]></b:skin>
</head>
<body>

<div id='page-wrapper'>
    <header>
      <b:section class='header-section' id='header' maxwidgets='1' showaddelement='yes'>
        <b:widget id='Header1' locked='true' title='Header' type='Header'/>
      </b:section>
    </header>

    <main>
      <b:section class='main-section' id='main' maxwidgets='1' showaddelement='yes'>
        <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog'>
          <b:includable id='main'>
            <b:if cond='data:posts and !data:posts.empty'>
              <b:loop values='data:posts' var='post'>
                <div class='post'>
                  <h2 class='post-title'>
                    <a expr:href='data:post.url'><data:post.title/></a>
                  </h2>
                </div>
              </b:loop>
            <b:else/>
              <div class='no-posts-found'>
                لا توجد أي تدوينات لعرضها. القالب يعمل بشكل صحيح.
              </div>
            </b:if>
          </b:includable>
        </b:widget>
      </b:section>
    </main>

    <footer>
        <b:section class='footer-section' id='footer' maxwidgets='1' showaddelement='yes'>
            <b:widget id='Text1' locked='false' title='' type='Text'>
                <b:includable id='main'>
                    <p>جميع الحقوق محفوظة &#169; <data:blog.title/></p>
                </b:includable>
            </b:widget>
        </b:section>
    </footer>
</div>

</body>
</html>
